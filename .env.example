# Konfigurasi AI (Groq) — wajib untuk analisis NLP
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000

# Google Maps Platform — wajib untuk perhitungan rute transit nyata
# Aktifkan Maps Routes API (kode: routes.googleapis.com) lalu isi API key kamu (bisa pakai demo key).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes